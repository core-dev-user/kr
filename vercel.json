{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "EXPO_NO_TELEMETRY=1 npm run build:web",
  "outputDirectory": "apps/mobile/dist",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
